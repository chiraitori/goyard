# Discord bot token (required)
BOT_TOKEN=your_bot_token_here

# HTTP listen port (default: 4001)
PORT=4001

# Database path for embedded bbolt (default: ./data/lanyard.db)
DB_PATH=./data/lanyard.db

# Optional Redis connection (used when built with -tags redis)
# REDIS_URL=redis://127.0.0.1:6379

# Bot command prefix (default: .)
COMMAND_PREFIX=.

# Bot status text (default: you <3)
BOT_PRESENCE=you <3

# Bot status activity type: 0=Playing, 1=Streaming, 2=Listening, 3=Watching, 5=Competing (default: 3)
BOT_PRESENCE_TYPE=3

# Public base URL used in bot replies and links (default: https://api.lanyard.rest)
EXTERNAL_URL=https://api.lanyard.rest

# Optional Discord invite link shown at GET / and GET /discord
DISCORD_INVITE=

# Optional idempotency key in format ENVNAME=expected
# If set, bot commands are handled only when os.Getenv(ENVNAME) == expected
BOT_IDEMPOTENCY_ENV_KEY=

# Logging level (debug, info, warn, error) and format (text, json)
LOG_LEVEL=info
LOG_FORMAT=text

# Max concurrent WebSocket clients (default: 5000)
MAX_SOCKETS=5000
